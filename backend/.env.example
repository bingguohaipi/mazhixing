# 应用
APP_NAME=码智星 OJ 平台
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# 数据库（开发可用 SQLite，生产使用 MySQL）
DATABASE_URL=sqlite:///./mazhixing.db
# DATABASE_URL=mysql+pymysql://mzx:mzx123456@localhost:3306/mazhixing?charset=utf8mb4

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS（前端开发地址）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 开发环境短信验证码（固定值，生产需接入真实短信服务）
DEV_SMS_CODE=123456

# 判题服务（Judge0 沙箱，生产环境必须配置）
# 启动: ./backend/scripts/start_judge0.sh
# JUDGE0_URL=http://localhost:2358
# JUDGE0_AUTH_TOKEN=
# JUDGE0_REQUIRED=false
# JUDGE0_ALLOW_LOCAL_FALLBACK=true

# Celery 异步判题（需 Redis；开发默认同步判题）
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true
JUDGE_ASYNC=true

# AI 错题解析（OpenAI 兼容接口）
AI_ENABLED=true
# 阿里 Qwen（Model Studio OpenAI 兼容接口）
# OPENAI_API_KEY=sk-ws-xxx
# OPENAI_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://ws-b4408sz9e2am7iac.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
AI_DAILY_LIMIT=5
AI_TEACHER_DAILY_LIMIT=10
AI_TIMEOUT_SECONDS=8

# 短信（开发默认 mock，不真实发送）
SMS_ENABLED=true
SMS_PROVIDER=mock

# 号码认证短信验证码（Dypnsapi：SendSmsVerifyCode / CheckSmsVerifyCode）
# SMS_PROVIDER=dypns
# 可与 dysms 共用 AK，或单独配置 ALIYUN_DYPNS_ACCESS_KEY_*
# 与 OpenAPI 调试台一致（图1 SendSmsVerifyCode）
# ALIYUN_DYPNS_SIGN_NAME=在阿里云号码认证控制台查看
# ALIYUN_DYPNS_TEMPLATE_CODE=你的模板CODE
# ALIYUN_DYPNS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
# ALIYUN_DYPNS_SCHEME_NAME=
# ALIYUN_DYPNS_COUNTRY_CODE=86
# ALIYUN_DYPNS_VALID_TIME_SECONDS=300
# ALIYUN_DYPNS_SEND_INTERVAL_SECONDS=60
# ALIYUN_DYPNS_CODE_LENGTH=6

# 传统短信（dysmsapi SendSms，自行生成验证码）
# SMS_PROVIDER=aliyun
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# 监控
METRICS_ENABLED=true
# METRICS_TOKEN=

# 生产安全（开发可忽略）
# ENABLE_SEED=false
# ENABLE_OPENAPI=false
# RATE_LIMIT_ENABLED=true
# OPERATION_LOG_RETENTION_DAYS=90
# EVENT_LOG_RETENTION_DAYS=30
