# 生产环境配置示例 — 复制为 backend/.env 后修改
# 检查清单: deploy/PRODUCTION_CHECKLIST.md
# 自动检查: python scripts/check_production_env.py

APP_NAME=码智星 OJ 平台
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# MySQL（Docker 内网主机名为 mysql）
DATABASE_URL=mysql+pymysql://mzx:mzx123456@mysql:3306/mazhixing?charset=utf8mb4

ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 必须与 HTTPS 域名一致
CORS_ORIGINS=https://your-domain.com

# 判题沙箱（docker-compose.prod.yml 内置 Judge0，内网地址如下）
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_REQUIRED=true
JUDGE0_ALLOW_LOCAL_FALLBACK=false

# Celery 异步判题
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
JUDGE_ASYNC=true

# AI 解析
AI_ENABLED=true
OPENAI_API_KEY=sk-ws-your-qwen-api-key
OPENAI_BASE_URL=https://ws-b4408sz9e2am7iac.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
AI_DAILY_LIMIT=5
AI_TEACHER_DAILY_LIMIT=10
AI_TIMEOUT_SECONDS=8

# 生产安全（P0）
ENABLE_SEED=false
ENABLE_OPENAPI=false
RATE_LIMIT_ENABLED=true
OPERATION_LOG_RETENTION_DAYS=90
EVENT_LOG_RETENTION_DAYS=30

# 短信服务（P1 — 阿里云）
SMS_ENABLED=true
SMS_PROVIDER=aliyun
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=你的短信签名
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
# ALIYUN_SMS_TEMPLATE_CODE_REGISTER=SMS_xxx
# ALIYUN_SMS_TEMPLATE_CODE_RESET=SMS_yyy

# 监控（P1）
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-random-metrics-token
