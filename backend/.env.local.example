# 复制为 backend/.env.local（已 gitignore），本机 uvicorn 开发时覆盖 .env 里的 Docker/生产项
# cp backend/.env.local.example backend/.env.local

DEBUG=true
DATABASE_URL=sqlite:///./mazhixing.db

# 本机不连 Docker 内 Judge0/Redis 时使用同步判题 + 本地 Python/C++ 沙箱
JUDGE0_URL=
JUDGE0_REQUIRED=false
JUDGE0_ALLOW_LOCAL_FALLBACK=true
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
