{
  "name": "code-intelligence-stars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 127.0.0.1",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --reload --port 8001",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "axios": "^1.7.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "lottie-web": "^5.13.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.56.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.0",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.4.0",
    "typescript-eslint": "^8.25.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.0.0"
  }
}
